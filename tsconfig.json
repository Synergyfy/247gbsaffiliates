{
  "compilerOptions": {
    "target": "ES2022",
    "module": "NodeNext",
    "moduleResolution": "NodeNext",
    "strict": true,
    "skipLibCheck": true,
    "esModuleInterop": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "noEmit": true,
    "baseUrl": ".",
    "paths": {
      "@247gbsaffiliates/api": ["apps/api/src"],
      "@247gbsaffiliates/web": ["apps/web"]
    }
  },
  "exclude": ["node_modules", "dist", "build", ".next", ".turbo", "apps/*/node_modules"]
}