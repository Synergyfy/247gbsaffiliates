# ── 247gbsaffiliates API — example env ──
# Copy to .env and fill real values: cp .env.example .env

# Server — change ports/paths here, no code edit needed
PORT=7088
HOST=0.0.0.0
API_PREFIX=api/v1
NODE_ENV=development
FRONTEND_URL=http://localhost:7089
# Extra CORS origins (comma-separated)
CORS_ORIGINS=

# Database (Supabase PostgreSQL)
POSTGRES_HOST=your-supabase-pooler-host.supabase.com
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres.your-project-ref
POSTGRES_PASSWORD=your_supabase_database_password
POSTGRES_NAME=postgres
PGOPTIONS=

# Auth / JWT
JWT_ACCESS_SECRET=change-me-to-a-strong-random-secret
JWT_ACCESS_EXPIRATION=1d
JWT_SECRET=change-me-to-a-strong-random-secret
SSO_SECRET=change-me-to-a-strong-random-secret
ADMIN_REGISTRATION_SECRET=change-me-admin-registration-secret
INTERNAL_API_KEY=change-me-internal-api-key

# MCOM SSO / Central integration
MCOM_SOLUTIONS_URL=http://localhost:3010
MCOM_CENTRAL_URL=http://localhost:3010/api/v1
MCOM_CLIENT_ID=247gbs-affiliate
MCOM_CLIENT_SECRET=your-central-client-secret
MCOM_API_KEY=your-central-api-key
MCOM_SOLUTION_API_KEY=your-central-api-key
MCOM_HMAC_SECRET=change-me-hmac-secret
MCOM_REDIRECT_URI=http://localhost:7088/api/v1/auth/sso/callback
MCOM_SCOPES=profile email business
MCOM_PLATFORM_SLUG=247gbs_affiliate
# Central Hub frontend "create account" link returned by GET /auth/sso/config.
# Set per environment (no hardcoding in code):
#   local:   http://localhost:3000/register/affiliate
#   staging: https://staging.centralhubsolution.com/register/affiliate
#   prod:    https://centralhubsolution.com/register/affiliate
MCOM_MEMBERSHIP_URL=http://localhost:3000/register/affiliate
MCOM_WALLET_ENABLED=false
MCOM_WEBHOOK_SECRET=change-me-webhook-secret

# ── Schema management ──
# Local dev: true lets TypeORM create/update the schema from entities.
# Production/staging: false — apply the SQL files in ./migrations first.
DB_SYNC=false

# ── Central Hub backend-to-backend bridge ──
# INTERNAL_API_KEY (defined above) is the shared secret Central sends as
# x-api-key. It must match Central's AFFILIATE_INTERNAL_API_KEY.
# Central calls POST {MCOM_CENTRAL_URL}/affiliate/tasks/:id/status on submit.
# The affiliate calls Central with MCOM_SOLUTION_API_KEY / MCOM_API_KEY.

# ── Real-time chat (Central Hub WebSocket) ──
# Base URL the browser connects to for the /chat namespace. Defaults to
# MCOM_SOLUTIONS_URL with /api/v1 stripped.
MCOM_CENTRAL_SOCKET_URL=http://localhost:3010
