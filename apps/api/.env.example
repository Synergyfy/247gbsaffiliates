# =============================================================================
# Database Configuration (Supabase PostgreSQL)
# =============================================================================

POSTGRES_HOST=your-supabase-pooler-host.supabase.com
POSTGRES_PORT=5432
POSTGRES_USERNAME=postgres.your-project-ref
POSTGRES_PASSWORD=your_supabase_database_password
POSTGRES_NAME=postgres
PGOPTIONS=-c search_path=""

# =============================================================================
# Authentication
# =============================================================================

JWT_ACCESS_SECRET=your_jwt_access_secret
JWT_ACCESS_EXPIRATION=24h
JWT_SECRET=your_32byte_encryption_key_for_mcom_tokens

# =============================================================================
# Security
# =============================================================================

ADMIN_REGISTRATION_SECRET=your_admin_secret
INTERNAL_API_KEY=your_internal_api_key

# =============================================================================
# MCOM Solutions Central Hub — SSO + Billing
# =============================================================================

MCOM_SOLUTIONS_URL=https://api.centralhubsolution.com
MCOM_CLIENT_ID=your_platform_slug
MCOM_CLIENT_SECRET=cs_your_client_secret
MCOM_SOLUTION_API_KEY=ak_your_api_key
MCOM_HMAC_SECRET=hm_your_hmac_secret
MCOM_WEBHOOK_SECRET=wh_your_webhook_secret
SSO_SECRET=your_sso_shared_secret
MCOM_PLATFORM_SLUG=your_platform_slug
MCOM_REDIRECT_URI=http://localhost:3011/auth/callback
MCOM_SCOPES=profile email business membership packages
MCOM_MEMBERSHIP_URL=https://api.centralhubsolution.com
MCOM_WALLET_ENABLED=false
MCOM_CENTRAL_URL=https://api.centralhubsolution.com/api/v1

# =============================================================================
# Server
# =============================================================================

PORT=3012
NODE_ENV=development
FRONTEND_URL=http://localhost:3011
